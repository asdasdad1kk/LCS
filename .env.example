# Carpeta compartida con projects/<id>/repo.git
LCS_WORKSPACE=D:\LCS

# Estado y ajustes locales (por defecto: %LOCALAPPDATA%\LCS)
LCS_DATA_DIR=
LCS_PORT=7809
LCS_ACTOR=

# Identidad: por defecto sale de whoami /upn (correo corporativo). Déjalo vacío en la empresa;
# fuera del entorno corporativo pon uno falso, p. ej. dev@lcs.local
LCS_EMAIL=
LCS_SEED_DIR=

# Rutas de las herramientas si no están en el PATH
GO_BIN=C:\Program Files\Go\bin\go.exe
NODE_BIN=C:\Program Files\nodejs\node.exe
NPM_BIN=C:\Program Files\nodejs\npm.cmd
